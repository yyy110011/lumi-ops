{
  "name": "lumi-ops",
  "displayName": "Lumi-Ops",
  "description": "Shadow Clone Protocol - Git Worktree Automation for AI Agents",
  "version": "0.4.2",
  "publisher": "ZunRenYao",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "git",
    "worktree",
    "agent",
    "mcp",
    "parallel"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyy110011/lumi-ops"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lumi-ops",
          "title": "Shadow Ops",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "lumi-ops": [
        {
          "id": "lumi-ops.activeClones",
          "name": "Active Clones"
        },
        {
          "id": "lumi-ops.creator",
          "name": "Create Shadow Clone",
          "type": "webview"
        },
        {
          "id": "lumi-ops.promptLibrary",
          "name": "Prompt Library",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "lumi-ops.spawn",
        "title": "Lumi-Ops: Spawn Shadow Clone",
        "icon": "$(add)"
      },
      {
        "command": "lumi-ops.kill",
        "title": "Lumi-Ops: Kill Shadow Clone",
        "icon": "$(trash)"
      },
      {
        "command": "lumi-ops.merge",
        "title": "⚡ Squash & Merge"
      },
      {
        "command": "lumi-ops.refresh",
        "title": "Lumi-Ops: Refresh Clones",
        "icon": "$(refresh)"
      },
      {
        "command": "lumi-ops.open",
        "title": "Open Clone",
        "icon": "$(window)"
      },
      {
        "command": "lumi-ops.cycleReviewStatus",
        "title": "Cycle Status"
      },
      {
        "command": "lumi-ops.saveAsPrompt",
        "title": "Save as Prompt Template"
      },
      {
        "command": "lumi-ops.returnToRoot",
        "title": "Return to Root Workspace"
      },
      {
        "command": "lumi-ops.openPromptFile",
        "title": "Open Prompt File"
      },
      {
        "command": "lumi-ops.copyBranchName",
        "title": "Copy Branch Name"
      },
      {
        "command": "lumi-ops.openWorktreeManager",
        "title": "Open Worktree Manager (Beta)",
        "icon": "$(list-tree)"
      },
      {
        "command": "lumi-ops.pickCopyFolders",
        "title": "Pick Copy Folders",
        "category": "Lumi-Ops"
      },
      {
        "command": "lumi-ops.openSettings",
        "title": "Open Lumi-Ops Settings",
        "category": "Lumi-Ops",
        "icon": "$(gear)"
      },
      {
        "command": "lumi-ops.rebase",
        "title": "⟲ Rebase onto Base Branch"
      },
      {
        "command": "lumi-ops.abortRebase",
        "title": "⛔ Abort Rebase"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lumi-ops.refresh",
          "when": "view == lumi-ops.activeClones",
          "group": "navigation"
        },
        {
          "command": "lumi-ops.spawn",
          "when": "view == lumi-ops.activeClones",
          "group": "navigation"
        },
        {
          "command": "lumi-ops.openWorktreeManager",
          "when": "view == lumi-ops.activeClones",
          "group": "navigation"
        },
        {
          "command": "lumi-ops.openSettings",
          "when": "view == lumi-ops.activeClones",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lumi-ops.open",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone",
          "group": "inline@1"
        },
        {
          "command": "lumi-ops.kill",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone",
          "group": "inline@2"
        },
        {
          "command": "lumi-ops.copyBranchName",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone",
          "group": "modification@0"
        },
        {
          "command": "lumi-ops.merge",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone",
          "group": "modification@1"
        },
        {
          "command": "lumi-ops.rebase",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone",
          "group": "modification@2"
        },
        {
          "command": "lumi-ops.kill",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone",
          "group": "modification@3"
        },
        {
          "command": "lumi-ops.open",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone-detached",
          "group": "inline@1"
        },
        {
          "command": "lumi-ops.kill",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone-detached",
          "group": "inline@2"
        },
        {
          "command": "lumi-ops.copyBranchName",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone-detached",
          "group": "modification@0"
        },
        {
          "command": "lumi-ops.merge",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone-detached",
          "group": "modification@1"
        },
        {
          "command": "lumi-ops.rebase",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone-detached",
          "group": "modification@2"
        },
        {
          "command": "lumi-ops.abortRebase",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone-detached",
          "group": "modification@3"
        },
        {
          "command": "lumi-ops.kill",
          "when": "view == lumi-ops.activeClones && viewItem == shadowClone-detached",
          "group": "modification@4"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "lumi-ops.missionTemplateEditor",
        "displayName": "Mission Template Editor",
        "selector": [
          {
            "filenamePattern": "**/.prompts/_missions/*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Lumi-Ops",
      "properties": {
        "lumi-ops.activeMissionTemplate": {
          "type": "string",
          "default": "default",
          "description": "Active mission template in 'name:scope' format (e.g. 'my-workflow:project'). Used when spawning new shadow clones."
        },
        "lumi-ops.copyOnSpawn": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "editPresentation": "multilineText",
          "markdownDescription": "Folders and files to copy from root into shadow clones on spawn (one per line).\n\n[$(folder) Browse workspace folders...](command:lumi-ops.pickCopyFolders)"
        },
        "lumi-ops.rootAgentMode": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "When enabled, injects a rule file (`.agents/rules/lumi-ops-root-agent.md`) that instructs AI agents in the **main workspace** to act as a strategist — analyzing tasks, discussing solutions, and writing prompts for shadow clones instead of implementing code directly."
        },
        "lumi-ops.cloneAgentRules": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "When enabled, injects a rule file (`.agents/rules/lumi-ops-clone-agent.md`) into clone workspaces that instructs AI agents to manage their clone status via MCP tools after completing work."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "package": "npx --yes esbuild src/extension.ts --bundle --format=cjs --platform=node --outfile=dist/extension.js --external:vscode --minify",
    "build": "npx --yes esbuild src/extension.ts --bundle --format=cjs --platform=node --outfile=dist/extension.js --external:vscode --sourcemap",
    "watch": "npx --yes esbuild src/extension.ts --bundle --format=cjs --platform=node --outfile=dist/extension.js --external:vscode --sourcemap --watch",
    "lint": "eslint src --ext ts",
    "pretest:integration": "bash scripts/setup-test-fixtures.sh && tsc -p tsconfig.test.json",
    "test:integration": "vscode-test"
  },
  "dependencies": {
    "@lumi-ops/cli": "workspace:*",
    "@vscode/codicons": "^0.0.44"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.27.3",
    "eslint": "^8.56.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "license": "GPL-3.0-or-later"
}
